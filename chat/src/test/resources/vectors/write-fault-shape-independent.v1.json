    "shellCases": [
      {
        "id": "MS-W1",
        "kind": "write_fault_no_switch",
        "given": {
          "currentPointer": "SET_A",
          "sets": {
            "SET_A": "bytes_A",
            "SET_B_new": "partial"
          }
        },
        "action": "write_new_set_fails_before_readback",
        "expect": {
          "currentPointer": "SET_A",
          "SET_A_bytesUnchanged": true,
          "switched": false
        }
      },
      {
        "id": "MS-W2",
        "kind": "write_fault_readback_mismatch_no_switch",
        "given": {
          "currentPointer": "SET_A",
          "sets": {
            "SET_A": "bytes_A"
          }
        },
        "action": "readback_differs",
        "expect": {
          "currentPointer": "SET_A",
          "SET_A_bytesUnchanged": true,
          "switched": false
        }
      },
      {
        "id": "MS-R1",
        "kind": "read_fault_keeps_data",
        "given": {
          "currentPointer": "SET_A",
          "sets": {
            "SET_A": "bytes_A"
          }
        },
        "action": "read_fails",
        "expect": {
          "deleted": false,
          "written": false,
          "SET_A_bytesUnchanged": true
        }
      }
    ]
  },
