      "expect": {
        "read": "absent",
        "create_write": "allowed_append_only",
        "replica": "not_applied",
        "orphan_key_read": false,
        "orphan_key_derived": false,
        "orphan_key_overwritten": false,
        "new_eoa_generated": true
      }
    },
    {
