  "states": {
    "G0": "设备无原生钥记录。no_key。",
    "G1": "设备有原生钥记录，本会话未成功 init。not_ready。",
    "G2": "已成功 init，EOA 与记录一致。既有行为，不在本向量内。"
  },
  "order": [
    "1. X-21 三名：not_supported（所有状态）。",
    "2. 允许清单（hello、pause、resume、destroy、nativeImportOpen）与状态查询（walletStatus、passcodeStatus）：按表 D。",
    "3. G0：其余一律 no_key，不读 payload。",
    "4. G1：init 核对 EOA，一致则 ok 并进入 G2，不一致或缺失则 address_mismatch；其余一律 not_ready，不读 payload。",
    "5. G2：既有行为。"
  ],
