  "kdf": {
    "alg": "PBKDF2-HMAC-SHA256",
    "passcode": "24681357",
    "saltHex": "000102030405060708090a0b0c0d0e0f",
    "iterations": 600000,
    "dkLen": 32,
    "outputHex": "da119d3656f7b4149767730c7a8157cd4707c73a82f9340d7bed17539c9d05f2",
    "note": "KAT：三端派生结果逐字节一致。口令仅为测试材料。"
  },
  "backoff": {
    "note": "口令解锁失败退避（2026-11-20）。只在 UI 层执行；原生对 passcodeUnlock 一律不计数、不冷却、不返回 backoff。旧 schedule（秒级递增）已废止，不再使用。",
    "enforcedBy": "ui_layer_only",
    "nativeCountsUnlockFailures": false,
    "nativeCooldown": false,
    "unit": "ms",
    "threshold": 3,
    "cooldownMs": 300000,
    "afterExpiry": "one_attempt_then_full_cooldown",
    "reCooldownMs": 300000,
    "clearOn": "ui_correct_unlock",
    "countPerInput": true,
    "nonCountingFailures": [
      "native_sync_failure",
      "storage_failure"
    ],
    "persistAcrossRestart": true,
    "cases": [
      {
        "id": "B-1",
        "title": "前两次错误不冷却",
        "events": [
          "wrong",
          "wrong"
        ],
        "expect": {
          "failures": 2,
          "silentMs": 0,
          "attemptAllowed": true
        }
      },
      {
        "id": "B-2",
        "title": "第三次错误立即静默 300000 ms",
        "events": [
          "wrong",
          "wrong",
          "wrong"
        ],
        "expect": {
          "failures": 3,
          "silentMs": 300000,
          "attemptAllowed": false
        }
      },
      {
        "id": "B-3",
        "title": "静默期内拒绝验证（不比对口令）",
        "events": [
          "wrong",
          "wrong",
          "wrong",
          "correct_during_silence"
        ],
        "expect": {
          "compared": false,
          "unlocked": false,
          "failures": 3
        }
      },
      {
        "id": "B-4",
        "title": "期满只给一次机会，正确即解锁并清零",
        "events": [
          "wrong",
          "wrong",
          "wrong",
          "expire",
          "correct"
        ],
        "expect": {
          "unlocked": true,
          "failures": 0,
          "silentMs": 0
        }
      },
      {
        "id": "B-5",
        "title": "期满后第一次仍错，重新静默完整 300000 ms",
        "events": [
          "wrong",
          "wrong",
          "wrong",
          "expire",
          "wrong"
        ],
        "expect": {
          "failures": 4,
          "silentMs": 300000,
          "attemptAllowed": false
        }
      },
      {
        "id": "B-6",
        "title": "重启后失败状态与到期时间保持",
        "events": [
          "wrong",
          "wrong",
          "wrong",
          "restart"
        ],
        "expect": {
          "failures": 3,
          "silentUntilPersisted": true
        }
      },
      {
        "id": "B-7",
        "title": "原生同步失败、存储故障不计为输错",
        "events": [
          "wrong",
          "wrong",
          "native_sync_failure",
          "storage_failure"
        ],
        "expect": {
          "failures": 2,
          "silentMs": 0
        }
      },
      {
        "id": "B-8",
        "title": "一次输入只计一次（重复提交同一输入不重复计数）",
        "events": [
          "wrong",
          "wrong",
          "wrong_same_input_twice"
        ],
        "expect": {
          "failures": 3
        }
      }
    ]
  },
  "wrapping": {
    "layers": [
      "H：硬件密钥（iOS Keychain 非导出 AES-256-GCM；Android Keystore AES-256-GCM）",
      "P：Passcode 派生 AES-256-GCM（PBKDF2 参数见 kdf）"
