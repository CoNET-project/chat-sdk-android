    "aadH": "beamio-native-wallet-v1|h|<eoa 小写>",
    "aadP": "beamio-native-wallet-v1|p|<eoa 小写>|v1",
    "versions": {
      "record": 1,
      "kdf": "PBKDF2-HMAC-SHA256/600000/32",
      "wrap": "AES-256-GCM/96-bit IV/128-bit tag"
    }
