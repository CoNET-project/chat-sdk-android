{
  "schema": "keystore-replica-vectors.v1",
  "spec": "r3rv（§25.52T.3 末段、§25.52W.4；R2210）",
  "note": "合成状态；期望值由人工写定；不含具体地址。native_key：readable（可读 EOA 密钥）、unreadable（有密钥但不可读）、none（无密钥）。",
  "cases": [
    {
      "id": "KR-01",
      "title": "钥库有可读 EOA 密钥，无副本，旧存储确认为空，指针为空：absent 接收，不建号，由 replicaAnswer 建副本（应答 ok，EOA 等于钥库 EOA）",
      "state": {
        "native_key": "readable",
        "page_copy": false,
        "pointer": false,
        "legacy": "absent",
        "marker": false
      },
      "expect": {
        "read": "absent",
        "create_write": "migrating",
        "replica": "ok_same_eoa",
        "new_eoa_generated": false
      }
    },
    {
      "id": "KR-02",
      "title": "钥库有 EOA 密钥但不可读：needs_native_recovery，不判为无账户，不建号",
      "state": {
        "native_key": "unreadable",
        "page_copy": false,
        "pointer": false,
        "legacy": "absent",
        "marker": false
      },
      "expect": {
        "read": "error:needs_native_recovery",
        "create_write": "migrating",
        "replica": "not_applied",
        "new_eoa_generated": false
      }
    },
    {
      "id": "KR-03",
      "title": "钥库无 EOA 密钥，无副本，旧存储确认为空，指针为空：absent，允许建号（全新安装）",
      "state": {
        "native_key": "none",
        "page_copy": false,
        "pointer": false,
        "legacy": "absent",
        "marker": false
      },
      "expect": {
        "read": "absent",
        "create_write": "allowed",
        "replica": "not_applied",
        "new_eoa_generated": true
      }
    },
    {
      "id": "KR-04",
      "title": "钥库有可读 EOA 密钥，无副本，旧存储已找到旧记录：import_not_done，不由钥库建副本，不建号",
      "state": {
        "native_key": "readable",
        "page_copy": false,
        "pointer": false,
        "legacy": "found",
        "marker": false
      },
      "expect": {
        "read": "error:import_not_done",
        "create_write": "migrating",
        "replica": "not_applied",
        "new_eoa_generated": false
      }
    },
    {
      "id": "KR-05",
      "title": "钥库有可读 EOA 密钥，无副本，旧存储不可读（标记置位）：migrating（r3rz，U.6），不建号",
      "state": {
        "native_key": "readable",
        "page_copy": false,
        "pointer": false,
        "legacy": "unreadable",
        "marker": true
      },
      "expect": {
        "read": "migrating",
        "create_write": "migrating",
        "replica": "not_applied",
        "new_eoa_generated": false
      }
    },
    {
      "id": "KR-06",
      "title": "钥库有可读 EOA 密钥，无副本，旧存储未读取：migrating，不建号",
      "state": {
        "native_key": "readable",
        "page_copy": false,
        "pointer": false,
        "legacy": "unread",
        "marker": false
      },
      "expect": {
        "read": "migrating",
        "create_write": "migrating",
        "replica": "not_applied",
        "new_eoa_generated": false
      }
    },
    {
      "id": "KR-07",
      "title": "钥库有可读 EOA 密钥，指针存在：account_record_missing，不建副本，不建号",
      "state": {
        "native_key": "readable",
        "page_copy": false,
        "pointer": true,
        "legacy": "absent",
        "marker": false
      },
      "expect": {
        "read": "error:account_record_missing",
        "create_write": "migrating",
        "replica": "not_applied",
        "new_eoa_generated": false
      }
    }
  ]
}
