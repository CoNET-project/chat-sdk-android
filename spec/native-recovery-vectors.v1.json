{
  "file": "native-recovery-vectors.v1.json",
  "purpose": "原生恢复页与恢复引擎（spec r3u §25.42）：路径 A（恢复码）与路径 B（账号名加密码）的步骤、错误码、退避，以及记录的解密兼容性。合成数据：恢复码、口令、账号名、注册表记录均为生成器构造，助记词为 BIP-39 公开测试助记词。",
  "spec": "v1.1-r3u §25.42（测试 T-228 至 T-232）",
  "generator": "gen-native-recovery-vectors.mjs",
  "sourceAlgorithm": {
    "file": "src/SilentPassUI（PWA SilentPassUI-v2 工作树 services/beamio.ts）",
    "functions": [
      "createRecover",
      "restoreWithRedeem",
      "restoreWithUserPin",
      "aesGcmEncryptWithStored",
      "aesGcmDecryptWithStored",
      "deriveAesKeyFromPassword",
      "generateCODE"
    ]
  },
  "kdf": {
    "algo": "argon2id",
    "version": 19,
    "defaultParams": {
      "m": 32768,
      "t": 3,
      "p": 1
    },
    "dkLen": 32,
    "passwordEncoding": "UTF-8",
    "salt": "base64",
    "cipher": "AES-256-GCM",
    "ivBytes": 12,
    "tagBytes": 16,
    "layout": "base64(iv || ciphertext || tag)"
  },
  "record": {
    "format": "base64(JSON({stored, img}))",
    "storedFields": [
      "algo",
      "v",
      "m",
      "t",
      "p",
      "salt",
      "hash"
    ]
  },
  "registryKeys": {
    "pathA": "keccak256(solidityPacked(string, [recoveryCode]))，读取 getBase64ByNameHash(bytes32)",
    "pathB": "账号名字符串，读取 getBase64ByAccountName(string)"
  },
  "recoveryCodeFormat": {
    "regex": "^[0-9A-Za-z]{22}$",
    "source": "uuid62.v4()（20000 个样本全部符合）"
  },
  "backoff": {
    "table": {
      "5": 30,
      "6": 60,
      "7": 300,
      "8": 900,
      ">=9": 3600
    },
    "counted": "bad_pin only (path B)",
    "reset": "on ok"
  },
