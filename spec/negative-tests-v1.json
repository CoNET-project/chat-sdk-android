      {
        "id": "T-131-control",
        "surface": "positive-control",
        "executor": "test-harness（注入正控制样例）",
        "sample": "leak test: 5e1c2d6840b2a54f911848b39b7de0372424e3029581e3fc0e3a1703bdd6cd6d",
        "expect": [
          "wallet-private-key-hex"
        ]
      }
