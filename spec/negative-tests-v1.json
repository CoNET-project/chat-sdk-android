{
  "spec": "spec v1.1-r3b §25.22（负例规格），第二十五批",
  "status": "合成数据。三端实现前以本文件为准。各端须运行同一组用例；X-19 未批准的 iOS PGP 用例标为阻塞，不得跳过。",
  "shellOrigin": "https://shell.test.invalid",
  "bridgeSource": {
    "rule": "只接受 isMainFrame === true 且 origin 与 shellOrigin 完全一致的消息",
    "cases": [
      {
        "id": "T-119",
        "name": "iframe",
        "src": {
          "isMainFrame": false,
          "origin": "https://shell.test.invalid",
          "kind": "iframe"
        },
        "expect": false
      },
      {
        "id": "T-120",
        "name": "subframe",
        "src": {
          "isMainFrame": false,
          "origin": "https://shell.test.invalid",
          "kind": "subframe"
        },
        "expect": false
      },
      {
        "id": "T-121",
        "name": "forged-origin",
        "src": {
          "isMainFrame": true,
          "origin": "https://shell.test.invalid.evil",
          "kind": "main"
        },
        "expect": false
      },
      {
        "id": "T-121b",
        "name": "other-site",
        "src": {
          "isMainFrame": true,
          "origin": "https://other.test.invalid",
          "kind": "main"
        },
        "expect": false
      },
      {
        "id": "T-122a",
        "name": "null-origin",
        "src": {
          "isMainFrame": true,
          "origin": "null",
          "kind": "main"
        },
        "expect": false
      },
      {
        "id": "T-122b",
        "name": "about-blank",
        "src": {
          "isMainFrame": true,
          "origin": "about:blank",
          "kind": "main"
        },
        "expect": false
      },
      {
        "id": "T-122c",
        "name": "file-origin",
        "src": {
          "isMainFrame": true,
          "origin": "file://",
          "kind": "main"
        },
        "expect": false
      },
      {
        "id": "T-control",
        "name": "main-frame-expected-origin",
        "src": {
          "isMainFrame": true,
          "origin": "https://shell.test.invalid",
          "kind": "main"
        },
        "expect": true
      }
    ]
  },
  "pgpFixedDomain": {
    "purposes": [
      "chatEnvelope",
      "groupMessage",
      "voiceSignal"
    ],
    "allowedSigTypes": [
      "0x00",
      "0x01"
    ],
    "domainTagRule": "beamio.pgp.<purposeId>.v1 加换行，由原生生成，调用方不得提供",
    "cases": [
      {
        "id": "T-125",
        "name": "unknown-purpose",
        "req": {
          "purposeId": "arbitraryDomain",
          "sigType": "0x00"
        },
        "expect": false
      },
      {
        "id": "T-126",
        "name": "certification-0x10",
        "req": {
          "purposeId": "chatEnvelope",
          "sigType": "0x10"
        },
        "expect": false
      },
      {
        "id": "T-126b",
        "name": "certification-0x13",
        "req": {
          "purposeId": "chatEnvelope",
          "sigType": "0x13"
        },
        "expect": false
      },
      {
        "id": "T-control-sign",
        "name": "enumerated-document-sig",
        "req": {
          "purposeId": "chatEnvelope",
          "sigType": "0x01"
        },
        "expect": true,
        "domainTag": "beamio.pgp.chatEnvelope.v1\n"
      }
    ]
  },
  "importPolicy": {
    "keyCarryingCommands": [
      "walletTransferOnce"
    ],
    "forbiddenImportCommandNames": [
      "importWallet",
      "setPrivateKey",
      "importPrivateKey",
      "importMnemonic",
      "setLocalSigner"
    ],
    "cases": [
      {
        "id": "T-127",
        "name": "key-in-init",
        "command": "init",
        "carriesKey": true,
        "expect": "key_over_bridge_refused"
      },
      {
        "id": "T-127b",
        "name": "key-in-provisionIdentity",
        "command": "provisionIdentity",
        "carriesKey": true,
        "expect": "key_over_bridge_refused"
      },
      {
        "id": "T-127c",
        "name": "walletTransferOnce-solicited",
        "command": "walletTransferOnce",
        "carriesKey": true,
        "solicited": true,
        "expect": "accepted"
      },
      {
        "id": "T-127d",
        "name": "walletTransferOnce-unsolicited",
        "command": "walletTransferOnce",
        "carriesKey": true,
        "solicited": false,
        "expect": "refused"
      }
    ]
  },
