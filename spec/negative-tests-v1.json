    "cases": [
      {
        "id": "T-131",
        "surface": "native-log",
        "executor": "native（各原生端的日志输出，SDK 与壳）",
        "sample": "native: cold start ok; ready=true; eoa=0xabababababababababababababababababababab; bridge ack ok",
        "expect": []
      },
      {
        "id": "T-132",
        "surface": "webview-console-storage",
        "executor": "shell（WebView 控制台与存储采集由壳执行；SDK 不执行）",
        "sample": "native: cold start ok; ready=true; eoa=0xabababababababababababababababababababab; bridge ack ok",
        "expect": []
      },
      {
        "id": "T-131-control",
        "surface": "positive-control",
        "executor": "test-harness（注入正控制样例）",
        "sample": "leak test: 88e524cac1fab707de9ece36898aec543889f912bfe357f761cfecbaa2eb73cc",
        "expect": [
          "wallet-private-key-hex"
        ]
      }
    ],
    "sampleRule": "模式值 hexPattern(id) = SHA-256(\"hex:\" + id) 的十六进制（sha256Label 为模式编号）。wallet-private-key-hex 的值为 SHA-256(\"hex:wallet-private-key-hex\")。样例为 \"leak test: \" 加该值。合成值，由标签派生，不是密钥，不得出现在任何真实日志中",
    "positiveControl": "control（扫描器必须命中一条注入的模式）",
    "controlPattern": {
      "id": "wallet-private-key-hex",
      "value": "88e524cac1fab707de9ece36898aec543889f912bfe357f761cfecbaa2eb73cc",
      "sha256Label": "wallet-private-key-hex",
      "inputString": "hex:wallet-private-key-hex",
      "rule": "value = SHA-256 of the UTF-8 bytes of inputString, hex-encoded; the scanner reports the canonical id when the value occurs"
    }
  }
