    "retrySeconds": 120,
    "hasKey": true,
    "storeWrite": "blocked"
   }
  },
  {
   "id": "WK-05",
   "name": "钥库暂时不可用（枚举失败）：判未知，不推定为没有；第三次重试后转手动",
   "rule": "Y.122 第 1 项",
   "input": {
    "probe": {
     "platform": "android",
     "enumeration": "failed",
     "aliasPresent": null,
     "iosSeQuery": "ok",
     "iosOtherQuery": "ok",
     "iosSeError": "none",
