    "storeWrite": "blocked"
   }
  },
  {
   "id": "WK-06",
   "name": "新槽写入后旧文件字节不变（旧不可解记录保留）",
   "rule": "Y.122 第 3 项",
   "input": {
    "store": "write_ok"
   },
   "expect": {
    "oldFileSha": "unchanged",
    "newSlotWritten": true,
    "newSlotDistinctFromOld": true,
    "classificationAfter": "confirmed_missing"
   }
  },
  {
   "id": "WK-07",
   "name": "已确认丢失且旧记录不可解：already_exists 不阻断，写入新槽位并留审计（旧文件不删）",
   "rule": "Y.122 第 3 项",
   "input": {
    "store": "write_ok",
    "existingDecryptable": false,
    "classification": "confirmed_missing"
   },
   "expect": {
    "blocking": false,
    "auditRecorded": true,
    "oldFileSha": "unchanged"
   }
  },
  {
   "id": "WK-08",
   "name": "旧记录可解：already_exists 仍阻断，不写入（即使探测为缺失）",
   "rule": "Y.122 第 3 项",
   "input": {
    "existingDecryptable": true,
    "classification": "confirmed_missing"
   },
   "expect": {
    "blocking": true,
    "newSlotWritten": false
   }
  },
