{
 "$comment": "wrap-key loss vectors (spec 25.52Y.122, 25.52Y.123). Generated by gen-wrap-key-loss-vectors.mjs; deterministic; no key material.",
 "vectorsVersion": 1,
 "retrySeconds": [
  30,
  120,
  600
 ],
 "classificationRule": "confirmed_missing only when enumeration (Android) or the iOS SE and Keychain queries succeed and the alias is absent / errSecItemNotFound; otherwise unknown.",
 "cases": [
  {
   "id": "WK-01",
   "name": "别名确认缺失（Android，枚举成功），PWA 无助记词：判没有，直接 onboarding",
   "rule": "Y.122 第 1、2 项",
   "input": {
    "probe": {
     "platform": "android",
     "enumeration": "ok",
     "aliasPresent": false,
     "iosSeQuery": "ok",
     "iosOtherQuery": "ok",
     "iosSeError": "none",
     "failure": null,
     "recPresent": false
    },
    "pwa": {
     "idbRead": "ok",
     "idbMnemonic": false
    },
    "retryAttempt": 0
   },
   "expect": {
    "classification": "confirmed_missing",
    "walletStatus": {
     "status": "no_key"
    },
    "page": "onboarding",
    "intermediateHint": false,
    "hasKey": false
   }
  },
  {
   "id": "WK-02",
   "name": "别名确认缺失，PWA 有可读助记词：照常恢复 PWA 账户，不进入 onboarding",
   "rule": "Y.122 第 2 项",
   "input": {
    "probe": {
     "platform": "android",
     "enumeration": "ok",
     "aliasPresent": false,
     "iosSeQuery": "ok",
     "iosOtherQuery": "ok",
     "iosSeError": "none",
     "failure": null,
     "recPresent": false
    },
    "pwa": {
     "idbRead": "ok",
     "idbMnemonic": true
    },
    "retryAttempt": 0
   },
   "expect": {
    "classification": "confirmed_missing",
    "walletStatus": {
     "status": "not_ready",
     "notReadyReason": "g1_uninitialized"
    },
    "page": "restore_pwa_account",
    "intermediateHint": false,
    "hasKey": false
   }
  },
  {
   "id": "WK-03",
   "name": "aead_failed：判未知（不得判没有），按 30 秒重试",
   "rule": "Y.122 第 1 项",
   "input": {
    "probe": {
     "platform": "android",
     "enumeration": "ok",
     "aliasPresent": true,
     "iosSeQuery": "ok",
     "iosOtherQuery": "ok",
     "iosSeError": "none",
