  {
   "id": "WK-14",
   "name": "探测序列 确认丢失 → aead_failed：各次读取只按当前探测判定（Y.144，不以会话历史锁存）；最后一次为 aead_failed，判未知",
   "rule": "Y.144",
   "input": {
    "probeSequence": [
     "confirmed",
     "aead_failed"
    ]
   },
   "expect": {
    "classificationAfter": "unknown",
    "walletStatus": {
     "status": "not_ready",
     "notReadyReason": "unreadable"
    }
   }
  },
  {
   "id": "WK-15",
   "name": "丢钥后先触发一次 seal（有旧钥封存记录，别名缺失）：fail closed，上报 wrap_key_missing，不生成新钥，不变成 aead_failed",
   "rule": "Y.124 第 2 项 (a)、第 3 项",
   "input": {
    "op": "seal",
    "probe": {
     "platform": "android",
     "enumeration": "ok",
     "aliasPresent": false,
     "iosSeQuery": "ok",
     "iosOtherQuery": "ok",
     "iosSeError": "none",
     "failure": null,
     "recPresent": false,
     "hasOldSealedRecord": true
    }
   },
   "expect": {
    "result": "wrap_key_missing",
    "newKeyCreated": false,
    "classification": "confirmed_missing",
    "walletStatus": {
     "status": "no_key"
    },
    "failureCode": "not_aead_failed"
   }
  },
  {
   "id": "WK-16",
