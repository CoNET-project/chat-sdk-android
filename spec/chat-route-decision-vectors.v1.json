  "D_capabilityState": {
    "rule": "壳构建（buildKind=shell）或桥可用即为壳；壳内永不进入页内持钥路径。identity.native-keys.v1 与 identity.route-register.native.v1 独立判定。缺 identity.native-keys.v1 时不发送任何载荷。",
    "cases": [
      {
        "id": "D-1",
        "desc": "浏览器（非壳构建，无桥）",
        "input": {
          "buildKind": "web",
          "bridge": false,
          "caps": []
        },
        "expect": {
          "chatMode": "browser",
          "nativeChatStarted": false,
          "pageHoldsKey": true,
          "routeRegisterPath": "page_signing_browser_exception",
          "payloadSent": "page_only",
          "uiState": "browser_chat"
        }
      },
      {
        "id": "D-2",
        "desc": "壳，桥可用，声明两个能力位",
        "input": {
          "buildKind": "shell",
          "bridge": true,
          "caps": [
            "identity.native-keys.v1",
            "identity.route-register.native.v1"
          ]
        },
        "expect": {
          "chatMode": "native",
          "nativeChatStarted": true,
          "pageHoldsKey": false,
          "routeRegisterPath": "native_chatRouteRegister",
          "payloadSent": "public_fields_only",
          "uiState": "native_chat"
        }
      },
      {
        "id": "D-3",
        "desc": "壳，桥可用，旧壳（无能力位）",
        "input": {
          "buildKind": "shell",
          "bridge": true,
          "caps": []
        },
        "expect": {
          "chatMode": "unavailable",
          "nativeChatStarted": false,
          "pageHoldsKey": false,
          "routeRegisterPath": "native_unavailable_no_fallback",
          "payloadSent": "none",
          "uiState": "chat_unavailable"
        }
      },
      {
        "id": "D-4",
        "desc": "壳，桥可用，声明 identity.native-keys.v1 但未声明路由能力位",
        "input": {
          "buildKind": "shell",
          "bridge": true,
          "caps": [
            "identity.native-keys.v1"
          ]
        },
        "expect": {
          "chatMode": "native",
          "nativeChatStarted": true,
          "pageHoldsKey": false,
          "routeRegisterPath": "native_unavailable_no_fallback",
          "payloadSent": "public_fields_only",
          "uiState": "native_chat"
        }
      },
      {
        "id": "D-5",
        "desc": "壳构建，但桥不可用（不得回退为页内持钥）",
        "input": {
          "buildKind": "shell",
          "bridge": false,
          "caps": []
        },
        "expect": {
          "chatMode": "unavailable",
          "nativeChatStarted": false,
          "pageHoldsKey": false,
          "routeRegisterPath": "native_unavailable_no_fallback",
          "payloadSent": "none",
          "uiState": "chat_unavailable"
        }
      }
    ]
