  },
  "ackEnvelopeRule": {
    "success": "{type:\"ack\", reqId, ok:true, result:{...}}。result 为对象。不得含 code 与顶层数据字段。",
    "failure": "{type:\"ack\", reqId, ok:false, error:\"<码>\"}。不得含 result。",
    "reqIdEchoFailure": "reqId 不合格时：{type:\"ack\", reqId:null, ok:false, error:\"bad_request\"}"
  },
