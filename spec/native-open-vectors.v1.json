{
  "file": "native-open-vectors.v1.json",
  "purpose": "原生导入页与恢复页的打开命令（spec r3t §25.41）：正式命令名、无别名、入参、应答码、宿主三态、结果事件的字段边界。合成数据，不含任何凭据或密钥。",
  "spec": "v1.1-r3t §25.41（测试 T-224 至 T-227）；r3x §25.46.10 新增 N-20 至 N-28（建号入口，测试 T-237 至 T-238）",
  "generator": "gen-native-open-vectors.mjs",
  "names": {
    "importPage": "nativeImportOpen（私钥或助记词）",
    "recoveryPage": "nativeRecoveryOpen（恢复码，路径 A；账号名加密码，路径 B）",
    "accountPage": "nativeAccountCreateOpen（G0 建号，§25.46）",
    "aliases": "无（recoveryCreateOpen 不是其别名，§25.46.2）"
  },
  "accountGate": "nativeAccountCreateOpen：宿主未注册先判，任何状态为 not_supported；已注册时 G1、G2 为 not_available（不调用宿主）；G0 调用宿主（ok 或 not_available）。不返回 no_key 或 not_ready。",
  "hostStates": {
    "absent": "宿主未注册：not_supported，不返回 ok",
    "refuse": "宿主已注册但此刻不能打开：not_available",
    "open": "宿主已打开：ack ok"
  },
  "ackErrorCodes": [
    "bad_request",
    "key_over_bridge_refused",
    "not_supported",
    "not_available"
  ],
  "credentialFields": [
    "privateKeyHex",
    "privateKeyArmored",
    "pgpPrivateKeyArmored",
    "pgpPassphrase",
    "walletPrivateKey",
    "mnemonic",
    "recoveryCode",
    "pin",
    "password",
    "accountPassword"
  ],
