{
  "file": "native-open-vectors.v1.json",
  "purpose": "原生导入页与恢复页的打开命令（spec §25.41）：正式命令名、无别名、入参、应答码、宿主三态、结果事件的字段边界。合成数据，不含任何凭据或密钥。",
  "spec": "v1.1- §25.41（测试 T-224 至 T-227）； §25.46.10 新增 N-20 至 N-28（建号入口，测试 T-237 至 T-238）； §25.46.2 增加 page 字段、同一页面再次打开与绑定结论先于开页（N-31 至 N-38）； 增加查询未决时的互斥（N-39 至 N-41）； 增加已完成 reqId 集合的保留（N-42）",
  "generator": "gen-native-open-vectors.mjs",
  "names": {
    "importPage": "nativeImportOpen（ 已移除：unknown_command；原私钥或助记词手输页不再存在）",
    "recoveryPage": "nativeRecoveryOpen（恢复码，路径 A；账号名加密码，路径 B）",
    "accountPage": "nativeAccountCreateOpen（G0 建号，§25.46）",
    "aliases": "无（recoveryCreateOpen 不是其别名，§25.46.2）"
  },
  "accountGate": "nativeAccountCreateOpen：宿主未注册先判，任何状态为 not_supported；已注册时 G1、G2 为 not_available（不调用宿主）；G0 先做绑定查询（查询先于开页），已绑定或查询失败为 ok page none 并经 nativeAccountCreateResult 送结果；确认无绑定时宿主拒绝为 not_available，宿主开页为 ok page opened。不返回 no_key 或 not_ready。",
  "accountAckPage": {
    "opened": "本命令已使页面处于第一屏（ok 且 page opened）",
    "none": "本命令未开页（ok 且 page none），结果经 nativeAccountCreateResult 送出"
  },
  "accountSecondOpen": "页面已开且该页无最终结果：不同 reqId 为 not_available；同一 reqId 为 ok page opened 且不重显；reqId 已有最终结果或页面已关闭后为 not_available；页面关闭后清空记录（d2d85f6 F-1）。另一 reqId 的绑定查询未决（含同一 reqId 再次送达）：not_available，不另起查询（M-1）。",
  "hostStates": {
    "absent": "宿主未注册：not_supported，不返回 ok",
    "refuse": "宿主已注册但此刻不能打开：not_available",
    "open": "宿主已打开：ack ok"
  },
  "ackErrorCodes": [
    "bad_request",
    "key_over_bridge_refused",
    "not_supported",
    "not_available"
  ],
  "credentialFields": [
    "privateKeyHex",
    "privateKeyArmored",
    "pgpPrivateKeyArmored",
    "pgpPassphrase",
    "walletPrivateKey",
    "mnemonic",
    "recoveryCode",
    "pin",
    "password",
    "accountPassword"
  ],
