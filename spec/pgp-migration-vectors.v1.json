{
  "meta": {
    "file": "pgp-migration-vectors.v1.json",
    "spec": "interface/spec.md §25.52A（r3at；§25.52 与 §25.51 中有差异处以 §25.52A 为准）",
    "status": "final-pending-PM-gates",
    "generator": "gen-pgp-migration-vectors.mjs（r3at）",
    "scope": "旧 PGP 私钥迁移（U5）。来源为 SDK 账户记录 L（只读）；目标为 N（每账户一条）；成功标记 M。只含状态与应答；不含密钥材料、armor、指纹全文、nonce 或签名输出。",
    "invariants": [
      "keygenCalls = 0：任何结果路径都不生成新 PGP 密钥（失败不自动换钥）",
      "bridgeKeyFields = 0：请求与事件都不含密钥字段；迁移入口不接收私钥参数",
      "每个请求最多一个结果事件（中断的运行不产生事件）",
      "L 在任何路径都不被删除、覆盖或修改（本版不清理 L）",
      "已有 N 且指纹 != F0：不覆盖、不删除，报 fingerprint_mismatch（failed）；N 指纹 == F0：幂等，不重写（r3at）",
      "已核验的 N（有 M）不被覆盖；与 L 不符时报 fingerprint_mismatch",
      "verify_unavailable 时不写入 N 或 M"
    ],
    "fp": "fp 为合成指纹标签（A、B），不是真实指纹",
    "gates": {
      "G0": "no_key",
      "G1": "not_ready",
      "G2locked": "locked"
    },
    "eventFields": [
      "type",
      "reqId",
      "code",
      "fp"
    ],
    "eventCodes": [
      "ok",
      "already_verified",
      "none",
      "store_missing",
      "legacy_unreadable",
      "account_mismatch",
      "fingerprint_mismatch",
      "chain_unavailable",
      "write_failed",
      "reread_failed",
      "challenge_failed",
      "verify_unavailable"
    ],
    "requestFields": [
      "type",
      "reqId"
    ],
    "forbiddenKeys": [
      "privateKeyArmor",
      "pgpPrivateKeyArmored",
      "pgpPassphrase",
      "privateKeyHex",
      "walletPrivateKey",
      "mnemonic",
      "recoveryCode"
    ],
    "stateNotation": "L：SDK 账户记录是否存在（只读）；N：迁移目标指纹标签；M：成功标记指纹标签"
  },
