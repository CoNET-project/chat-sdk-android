  {
   "id": "PNK-02",
   "title": "walletEoaAddress no_key，有页面副本：不映射 none，仅显示原生恢复入口，隐藏新建，不自动重试",
   "rule": "Y.151 第 1、3、4 项",
   "input": {
    "native": "no_key",
    "walletStatus": "no_key",
    "kPresent": false,
    "pageCopyPresent": true
   },
   "expect": {
    "mapping": "needs_native_recovery",
    "pageAction": "native_recovery_entry_only",
    "newAccountDisabled": true,
    "autoRetry": false
   }
  },
  {
   "id": "PNK-03",
   "title": "walletEoaAddress no_key，kPresent 缺失：不可判无，须恢复（不得 none）",
