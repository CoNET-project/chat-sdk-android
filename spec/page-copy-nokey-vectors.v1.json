   "input": {
    "native": "no_key",
    "walletStatus": "no_key",
    "kPresent": null,
    "pageCopyPresent": false
   },
   "expect": {
    "mapping": "needs_native_recovery",
    "pageAction": "retry_unknown"
   }
  },
  {
   "id": "PNK-04",
   "title": "walletEoaAddress no_key，kPresent 为真：不可判无",
   "rule": "Y.151 第 2 项",
   "input": {
    "native": "no_key",
    "walletStatus": "no_key",
    "kPresent": true,
    "pageCopyPresent": false
   },
   "expect": {
    "mapping": "needs_native_recovery",
    "pageAction": "native_recovery_entry_only",
    "newAccountDisabled": true,
    "autoRetry": false
   }
  },
  {
